{
  "name": "aqua-monitor-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "贝类育苗水质监测平台后端：Express + node:sqlite + 模拟数据生成器",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
