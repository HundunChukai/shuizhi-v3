# 贝类育苗水质监测平台 · 后端环境变量示例
# 复制为 server/.env 后按需修改（.env 已在根 .gitignore 中忽略）。

# HTTP 监听端口（前端 Vite 代理与单端口托管均默认指向此端口）
PORT=8787

# 模拟器写库间隔（毫秒），运行时会被 clamp 到 10000–30000
SIM_INTERVAL_MS=15000

# 原始时序数据保留天数，超期行由清理任务删除
RETENTION_DAYS=7

# 默认数据源：demo（演示/模拟）| live（实时/传感器）
DATA_SOURCE=demo

# 传感器接入令牌（POST /api/sensor-data 校验用）；留空表示不校验
SENSOR_TOKEN=
